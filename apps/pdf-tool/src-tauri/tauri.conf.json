{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Tool",
  "version": "0.1.0",
  "identifier": "com.benjylaw.pdftool",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "PDF Tool", "width": 520, "height": 660, "resizable": false, "maximizable": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

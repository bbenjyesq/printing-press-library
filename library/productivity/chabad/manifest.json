{
  "manifest_version": "0.3",
  "name": "chabad-pp-mcp",
  "display_name": "Chabad.org",
  "version": "0.1.0",
  "description": "Chabad.org's zmanim, Shabbat and holiday times, and daily Chitas in your terminal, plus a today dashboard, next-zman countdown, and weekly bulletin.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/chabad-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/chabad-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
